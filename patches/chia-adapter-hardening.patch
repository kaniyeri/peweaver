+class DirectGeminiLLM(VertexGeminiLLM):
+    """Gemini Developer API backend using an environment-held API key.
+
+    The implementation deliberately inherits VertexGeminiLLM's complete
+    generate-content/MCP tool loop.  Only client construction and the Ray
+    credential resource differ.  Direct/local calls do not consume the Ray
+    resource; ``prompt.chia_remote`` targets a worker advertising
+    ``gemini_creds``.
+    """
+
+    def __init__(
+        self,
+        model: str,
+        *,
+        api_key_env: str = "GEMINI_API_KEY",
+        logging_name: str = "gemini_direct",
+        **kwargs,
+    ):
+        self.api_key_env = api_key_env
+        # Project/location are irrelevant to the Developer API.  Keep the
+        # inherited fields harmless and out of direct client construction.
+        super().__init__(
+            model=model,
+            logging_name=logging_name,
+            project="",
+            location="",
+            **kwargs,
+        )
+
+    def _new_client(self):
+        from google import genai
+
+        api_key = os.environ.get(self.api_key_env, "").strip()
+        if not api_key:
+            raise AuthenticationError(
+                node_id=self._get_node_id(),
+                raw_message=f"required environment variable {self.api_key_env} is unset",
+            )
+        return genai.Client(api_key=api_key, **self._client_kwargs_with_timeout())
+
+    @ChiaFunction(resources={"gemini_creds": 0.01})
+    def prompt(
+        self,
+        user_message: str,
+        tools: Optional[List[ChiaTool]] = [],
+    ) -> QueryResult:
+        return VertexGeminiLLM.prompt(self, user_message, tools)
+

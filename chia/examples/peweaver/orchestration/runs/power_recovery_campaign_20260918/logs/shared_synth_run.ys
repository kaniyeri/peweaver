# PEWeaver Shared FFT candidate synthesis (Yosys) — sky130_fd_sc_hd tt_025C_1v80
read_verilog -sv \
    rtl/peweaver_ppa_shared_fft.v \
    rtl/peweaver_shared_fft.v

hierarchy -check -top peweaver_ppa_shared_fft
synth -top peweaver_ppa_shared_fft -flatten
read_liberty -lib -ignore_miss_func /work/peweaver/runs/power_opt_campaign_20260918/examples/peweaver/physical/results_power_opt/work/lib_shared_tt_synth.lib
dffunmap
dfflibmap -liberty /work/peweaver/runs/power_opt_campaign_20260918/examples/peweaver/physical/results_power_opt/work/lib_shared_tt_synth.lib
techmap -map synth/sky130_simple_map.v
setundef -zero
splitnets
opt_clean -purge
check
stat -liberty /work/peweaver/runs/power_opt_campaign_20260918/examples/peweaver/physical/results_power_opt/work/lib_shared_tt_synth.lib
write_verilog -noattr -noexpr -nodec results_power_opt/netlists/shared_ppa_synth.v

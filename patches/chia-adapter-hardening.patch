+def test_export_failure_retries_without_rerunning_agent(monkeypatch):
+    """Transient export failures are retried at the export layer only; the
+    agent run must NOT execute twice (a re-run would double-mutate files)."""
+    capture = {"calls": []}
+    _install_fake_subprocess(
+        monkeypatch,
+        run_stdout=_step_start("ses_exp1"),
+        export_obj=_export_obj(text="PONG"),
+        capture=capture,
+        export_fail_first_n=2,
+    )
+    llm = OpenCodeLLM(model="m/x", export_retries=3)
+    cli = llm.prompt("hi", tools=[])
+    assert cli.success is True
+    assert cli.result == "PONG"
+    subs = [c["sub"] for c in capture["calls"]]
+    assert subs == ["run", "export", "export", "export"]
+
+
+def test_persistent_export_failure_does_not_rerun_agent(monkeypatch):
+    """After export retries are exhausted, prompt() fails WITHOUT re-running
+    the agent (at-least-once mutation guard) and reports export_failed."""
+    capture = {"calls": []}
+    _install_fake_subprocess(
+        monkeypatch,
+        run_stdout=_step_start("ses_exp2"),
+        export_obj=_export_obj(text="PONG"),
+        capture=capture,
+        export_fail_first_n=99,
+    )
+    llm = OpenCodeLLM(model="m/x", export_retries=2)
+    cli = llm.prompt("hi", tools=[])
+    assert cli.success is False
+    assert "export_failed" in cli.stderr
+    assert [c["sub"] for c in capture["calls"]] == ["run", "export", "export"]
+    assert llm._last_metadata.get("session_id") == "ses_exp2"
+    assert llm._last_metadata.get("failure_reason") == "export_failed"
+
+
